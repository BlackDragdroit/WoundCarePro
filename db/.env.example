# =====================================================================
# WoundCarePro - Environment Configuration Template
# =====================================================================
# Copy this file to .env and change default values for production!
# NEVER commit the real .env file with secrets to GitHub.

# Database Credentials
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
DB_USER=wound_user
DB_PASSWORD=your_secure_user_password_here
DB_NAME=wound_care_pro
DB_PORT=3306

# API Configuration
PORT=3000

# Optional API Security Token:
# When set, all incoming requests to /api/patients, /api/wounds, /api/entries
# must provide this key via 'Authorization: Bearer <token>' or 'X-API-KEY: <token>' header.
API_SECRET_TOKEN=
